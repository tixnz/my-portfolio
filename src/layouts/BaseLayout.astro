---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../content/site';
import { t } from '../i18n/ui.no';

interface Props {
  title?: string;
  description?: string;
  theme?: 'lys' | 'mørk';
  noindex?: boolean;
  /** Sharing image for this page; defaults to /og-image.jpg (the front page cover) */
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article';
}

const {
  title,
  description = site.description,
  theme = 'lys',
  noindex = false,
  image,
  imageAlt,
  type = 'website',
} = Astro.props;
const fullTitle = title ? `${title} – ${site.name}` : `${site.name} – UX-designer`;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Sharing images must be absolute URLs. Case pages pass their card image.
const ogImagePath = image
  ? (await getImage({ src: image, width: 1200, format: 'jpg', quality: 85 })).src
  : '/og-image.jpg';
const ogImage = new URL(ogImagePath, Astro.site);
---

<!doctype html>
<html lang={site.lang} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={theme === 'mørk' ? '#1a1b1f' : '#fdfcfa'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Sharing (Open Graph / LinkedIn / Slack, and X) -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="nb_NO" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt ?? fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#innhold">{t('skip.toContent')}</a>
    <Header />
    <main id="innhold" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
