---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../content/site';
import { t } from '../i18n/ui.no';

interface Props {
  title?: string;
  description?: string;
  theme?: 'lys' | 'mørk';
  noindex?: boolean;
}

const { title, description = '', theme = 'lys', noindex = false } = Astro.props;
const fullTitle = title ? `${title} – ${site.name}` : site.name;
---

<!doctype html>
<html lang={site.lang} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={theme === 'mørk' ? '#1a1b1f' : '#fdfcfa'} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <a class="skip-link" href="#innhold">{t('skip.toContent')}</a>
    <Header />
    <main id="innhold" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
