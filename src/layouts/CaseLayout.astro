---
/**
 * Case page template (Figma "Case – SATS Quests v6 – desktop", 251:1303).
 *
 *   Title       back link, 112 px title, 30 px subtitle
 *   Hero        cover image, 1376 × 720
 *   Fakta       FactsRow
 *   Intro       44 px centred statement + 22 px intro (760 wide)
 *   Content     MDX body. <Result> spans the full width; <Section>s sit in the
 *               1088 px column next to the sticky table of contents.
 *   Neste       link to the next case
 */
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import FactsRow from '../components/FactsRow.astro';
import CaseToc from '../components/case/CaseToc.astro';
import NextProject from '../components/case/NextProject.astro';
import { t } from '../i18n/ui.no';

interface Props {
  entry: CollectionEntry<'cases'>;
  next?: CollectionEntry<'cases'>;
}

const { entry, next } = Astro.props;
const d = entry.data;
---

<BaseLayout
  title={d.title}
  description={d.subtitle ?? d.summary}
  theme={d.theme}
  image={d.cardImage}
  imageAlt={d.cardImageAlt}
  type="article"
>
  <article class="case">
    <header class:list={['page', 'title-block', { 'title-block--logo': d.titleLogo }]}>
      <a class="back" href="/#prosjekter">{t('case.allProjects')}</a>
      {
        d.titleLogo ? (
          <h1 class="logo-title">
            {d.titlePrefix && <span>{d.titlePrefix}</span>}
            <Image src={d.titleLogo} alt={d.titleLogoAlt ?? ''} height={120} class="logo-img" loading="eager" />
          </h1>
        ) : (
          <h1 class="title">{d.title}</h1>
        )
      }
      {d.subtitle && <p class="subtitle">{d.subtitle}</p>}
    </header>

    {
      d.cover && (
        <div class="page hero-wrap">
          <div class="hero-frame" style={d.coverBackground ? `background: ${d.coverBackground}` : undefined}>
            <Image
              src={d.cover}
              alt={d.coverAlt ?? ''}
              widths={[688, 1376, 2752]}
              sizes="(max-width: 1440px) calc(100vw - 2 * var(--page-margin)), 1376px"
              class:list={['hero', `hero--${d.coverFit}`]}
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
      )
    }

    <div class="page">
      <FactsRow facts={d.facts} />
    </div>

    {
      (d.statement || d.intro) && (
        <div class="page intro">
          {d.statement && <p class="statement">{d.statement}</p>}
          {d.intro && <p class="intro-text">{d.intro}</p>}
        </div>
      )
    }

    <div class:list={['page', 'case-content', { 'has-toc': d.toc.length > 0 }]}>
      {
        d.toc.length > 0 && (
          <CaseToc items={d.toc} logo={d.tocLogo} logoAlt={d.tocLogoAlt} logoHeight={d.tocLogoHeight} />
        )
      }
      <slot />
    </div>

    {next && <NextProject title={next.data.title} href={`/prosjekter/${next.id}/`} />}
  </article>
</BaseLayout>

<style>
  /* Title */
  .title-block {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-top: 96px;
    padding-bottom: var(--space-2xl);
  }
  .back {
    align-self: flex-start;
    font-size: var(--text-small);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    line-height: normal;
    color: var(--color-ink-strong);
    transition: color var(--duration) var(--ease-out);
  }
  .back:hover {
    color: var(--color-accent);
  }
  .title {
    font-size: clamp(3rem, 7.78vw, 7rem); /* 112 px at 1440 */
    line-height: 0.92;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--color-ink-strong);
  }
  /* Logo title (Figma 192:1252): text + logo image, centred, 120 px */
  .title-block--logo {
    padding-bottom: var(--space-3xl);
  }
  .logo-title {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-s);
    padding: 72px 0 var(--space-l);
    font-size: clamp(3rem, 8.33vw, 7.5rem); /* 120 px */
    font-weight: var(--weight-medium);
    line-height: 1;
    white-space: nowrap;
    color: var(--color-ink-strong);
  }
  .logo-img {
    width: auto;
    height: 1em;
  }
  .subtitle {
    max-width: 900px;
    font-size: clamp(1.25rem, 2.1vw, 1.875rem); /* 30 px */
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--color-ink-strong);
  }

  /* Hero */
  .hero-frame {
    aspect-ratio: 1376 / 720;
    overflow: hidden;
    border-radius: var(--radius-xs);
  }
  .hero {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero--contain {
    object-fit: contain;
  }

  /* Intro */
  .intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3xl);
    padding-block: var(--space-section);
  }
  .statement {
    max-width: 1050px;
    font-size: clamp(1.75rem, 3.06vw, 2.75rem); /* 44 px */
    line-height: 1.2;
    text-align: center;
    text-wrap: balance;
    color: var(--color-ink);
  }
  .intro-text {
    max-width: var(--text-measure);
    font-size: var(--text-body);
    line-height: 1.5;
    color: var(--color-ink);
  }

  /*
   * Content grid: TOC column (232) + gap (56) + main column (1088).
   * <Result> spans both columns; the TOC starts on the row after it.
   */
  .case-content {
    display: grid;
    grid-template-columns: 232px minmax(0, 1fr);
    column-gap: 56px;
    align-items: start;
  }
  .case-content > :global(*) {
    grid-column: 2;
  }
  .case-content > :global(.result) {
    grid-column: 1 / -1;
  }
  .case-content > :global(.toc) {
    grid-column: 1;
    grid-row: 1 / span 40;
  }
  .case-content:not(.has-toc) {
    grid-template-columns: minmax(0, 1fr);
  }
  .case-content:not(.has-toc) > :global(*) {
    grid-column: 1;
  }
  /*
   * With a result block: the TOC starts on the row after it, and there is
   * 120 px between the result and the sections + TOC. Without one, the
   * 120 px goes above the content instead. (Fully :global – Astro drops
   * scoped :has() and sibling selectors that mix scoped and global parts.)
   */
  :global(.case-content:has(> .result) > .toc) {
    grid-row: 2 / span 40;
  }
  :global(.case-content > .result + .case-section),
  :global(.case-content:has(> .result) > .toc) {
    margin-top: var(--space-section);
  }
  :global(.case-content.has-toc:not(:has(> .result))) {
    padding-top: var(--space-section);
  }

  /*
   * Long-form text written in MDX. :where() keeps specificity at zero so the
   * components' own scoped styles (captions, labels) always win.
   */
  :global(:where(.prose) p) {
    font-size: var(--text-body);
    line-height: 1.55;
    color: var(--color-body);
  }
  :global(:where(.prose) p.small) {
    font-size: var(--text-fact);
    line-height: 1.45;
    color: var(--color-ink-strong);
  }
  :global(:where(.prose) h3) {
    font-size: var(--text-h3);
    font-weight: var(--weight-medium);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--color-ink-strong);
  }
  :global(:where(.prose) strong) {
    font-weight: var(--weight-medium);
    color: var(--color-ink-strong);
  }

  @media (max-width: 1023px) {
    .case-content {
      grid-template-columns: minmax(0, 1fr);
    }
    .case-content > :global(*) {
      grid-column: 1;
    }
    .case-content > :global(.toc) {
      display: none;
    }
  }

  /* Mobile (Figma "Case – SATS Quests – mobil (skisse)", 398:11794) */
  @media (max-width: 767px) {
    .title-block {
      gap: 14px;
      padding-top: var(--space-l);
      padding-bottom: var(--space-xl);
    }
    .back {
      margin-bottom: var(--space-xs);
      font-size: 13px;
      color: var(--color-accent);
    }
    .title {
      font-size: 3rem; /* 48 */
    }
    .subtitle {
      font-size: 1.125rem; /* 18 */
    }
    .logo-title {
      padding: var(--space-l) 0 0;
      font-size: 2.75rem;
    }
    /* Hero runs edge to edge, 300 high */
    .hero-wrap {
      padding-inline: 0;
    }
    .hero-frame {
      aspect-ratio: auto;
      height: 300px;
      border-radius: 0;
    }
    .intro {
      gap: var(--space-l);
      padding-block: var(--space-xl) 40px;
    }
    .statement {
      font-size: 1.5rem; /* 24 */
    }
  }
</style>
