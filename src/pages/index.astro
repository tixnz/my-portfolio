---
/**
 * Front page (Figma "Front page", 121:661).
 * Cover: name hero filling the first screen, subline under the last word,
 * "Mine prosjekter" link and contact links at the bottom.
 * Prosjektoversikt: asymmetric grid of wide and tall cards in pairs. The wide
 * card in each row is pushed down (40 px, then 64 px) so the rows feel uneven.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { home } from '../content/home';

const cases = (await getCollection('cases', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const rows: (typeof cases)[] = [];
for (let i = 0; i < cases.length; i += 2) rows.push(cases.slice(i, i + 2));
const rowOffsets = [40, 64];
---

<BaseLayout description={home.subline}>
  <section class="cover" aria-labelledby="name">
    <div class="spacer"></div>

    <div class="name-block">
      <h1 id="name" class="name">
        {
          home.nameWords.map((word, i) => (
            <>
              {i > 0 && ' '}
              <span class:list={['word', { 'word--accent': i === home.accentIndex }]}>{word}</span>
            </>
          ))
        }
      </h1>
      <div class="subline-wrap">
        <!-- Invisible copy of the last word: gives this column the exact width of
             the word, so the subline starts at the same x as its first letter. -->
        <span class="ghost" aria-hidden="true">{home.nameWords.at(-1)}</span>
        <p class="subline">{home.subline}</p>
      </div>
    </div>

    <div class="spacer"></div>

    <div class="bottom">
      <a class="projects-link" href={home.projectsLink.href}>
        <span class="projects-label">
          {home.projectsLink.label.map((line) => <span>{line}</span>)}
        </span>
        <span class="projects-arrow" aria-hidden="true">↘</span>
      </a>
    </div>
  </section>

  <section id="prosjekter" class="projects" aria-label={home.projectsHeading}>
    <h2 class="visually-hidden">{home.projectsHeading}</h2>
    {
      rows.map((row, r) => (
        <div class="row" style={`--offset: ${rowOffsets[r % rowOffsets.length]}px`}>
          {row.map((entry) => (
            <div class:list={['slot', `slot--${entry.data.cardSize}`]}>
              <ProjectCard
                href={`/prosjekter/${entry.id}/`}
                title={entry.data.cardTitle ?? entry.data.title}
                meta={entry.data.meta}
                summary={entry.data.summary}
                image={entry.data.cardImage}
                imageAlt={entry.data.cardImageAlt}
                size={entry.data.cardSize}
                headingLevel="h3"
              />
            </div>
          ))}
        </div>
      ))
    }
  </section>
</BaseLayout>

<style>
  /* Cover: fills the first screen together with the 104 px header */
  .cover {
    display: flex;
    flex-direction: column;
    min-height: max(600px, calc(100svh - 104px));
    max-width: var(--page-max);
    margin-inline: auto;
    border-bottom: 1px solid var(--color-border);
  }
  .spacer {
    flex: 1 1 0;
  }

  .name-block {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-xs);
    padding-inline: 28px;
  }
  /* Shared by the name and the invisible measuring copy of the last word */
  .name,
  .ghost {
    font-size: min(124px, 8.612vw);
    font-weight: var(--weight-medium);
    letter-spacing: -0.02em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .name {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    width: 100%;
    line-height: 0.9;
    color: var(--color-ink-strong);
  }
  .word--accent {
    color: var(--color-accent);
  }

  /* Column as wide as the last word, right-aligned under it */
  .subline-wrap {
    display: grid;
  }
  .ghost {
    height: 0;
    overflow: hidden;
    visibility: hidden;
  }
  .subline {
    /* Never widens the column; wraps within the word's width */
    width: 0;
    min-width: 100%;
    font-size: var(--text-card-lead);
    line-height: 1.3;
    color: var(--color-ink-strong);
  }

  .bottom {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-xl);
    padding: 0 var(--page-margin) 40px;
  }
  .projects-link {
    display: inline-flex;
    align-items: flex-end;
    gap: var(--space-m);
    font-size: 26px;
    text-transform: uppercase;
    color: var(--color-ink-strong);
    transition: color var(--duration) var(--ease-out);
  }
  .projects-label {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }
  .projects-arrow {
    line-height: normal;
    transition: transform var(--duration) var(--ease-out);
  }
  .projects-link:hover {
    color: var(--color-accent);
  }
  .projects-link:hover .projects-arrow {
    transform: translate(3px, 3px);
  }

  /* Project overview */
  .projects {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
    max-width: var(--page-max);
    margin-inline: auto;
    padding: 96px var(--page-margin) 160px;
    scroll-margin-top: 0;
  }
  .row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3xl);
  }
  .slot--wide {
    flex: 0 1 690px;
    padding-top: var(--offset);
  }
  .slot--tall {
    flex: 0 1 620px;
  }

  @media (max-width: 767px) {
    .cover {
      min-height: max(560px, calc(100svh - 93px));
    }
    .name-block {
      align-items: stretch;
      padding-inline: var(--page-margin);
    }
    /* One column on phones: the subline uses the full width */
    .ghost {
      display: none;
    }
    .subline {
      width: auto;
      margin-top: var(--space-m);
      font-size: var(--text-fact);
    }
    .bottom {
      padding-inline: var(--page-margin);
    }
    .projects-link {
      font-size: 20px;
    }
    .projects {
      padding-block: var(--space-3xl) var(--space-section);
    }
    .row {
      flex-direction: column;
      gap: var(--space-2xl);
    }
    .slot--wide {
      padding-top: 0;
    }
    .slot {
      width: 100%;
    }
  }
</style>
