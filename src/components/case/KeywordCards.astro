---
/**
 * Cards with a caps label and a big accent word
 * (Figma TV-aksjonen "Funn (store ord)", 333:7550).
 */
interface Props {
  items: { label: string; value: string }[];
}
const { items } = Astro.props;
---

<ul class="keywords" style={`--cols: ${items.length}`}>
  {
    items.map((item) => (
      <li class="card">
        <p class="label-text">{item.label}</p>
        <p class="value">{item.value}</p>
      </li>
    ))
  }
</ul>

<style>
  .keywords {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: var(--space-m);
    padding: 0;
    list-style: none;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    padding: 28px var(--space-l) var(--space-xl);
    border-radius: var(--radius-xs);
    background: var(--color-card);
  }
  .label-text {
    font-size: var(--text-small);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.5;
    color: var(--color-ink-muted);
  }
  .value {
    font-size: clamp(1.5rem, 2.2vw, 2rem); /* 32 px */
    font-weight: var(--weight-medium);
    line-height: 1.15;
    color: var(--color-accent);
  }
  @media (max-width: 767px) {
    .keywords {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
