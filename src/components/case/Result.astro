---
/**
 * Result block (Figma "Resultat (lys)", 251:1345). Full page width; the
 * heading and lead sit on the 288 px inset, the media below can bleed.
 */
import CaseSectionHeading from '../CaseSectionHeading.astro';

interface Props {
  id: string;
  number: string;
  title: string;
  lead?: string;
}
const { id, number, title, lead } = Astro.props;
---

<section class="result" id={id} aria-labelledby={`${id}-heading`}>
  <div class="text case-column">
    <CaseSectionHeading number={number} id={`${id}-heading`}>{title}</CaseSectionHeading>
    {lead && <p class="lead">{lead}</p>}
  </div>
  <slot />
</section>

<style>
  .result {
    display: flex;
    flex-direction: column;
    gap: 40px;
    scroll-margin-top: var(--space-xl);
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  /* A step flow under the media sits on the inset with extra space above */
  .result :global(.result-flow) {
    margin-top: 240px;
  }
  /* Mobile (Figma "01 Løsningen", 398:11828): tighter gaps, 56 px below */
  @media (max-width: 767px) {
    .result {
      gap: var(--space-m);
      padding-top: var(--space-l);
    }
    .text {
      gap: 10px;
    }
    .result :global(.result-flow) {
      margin-top: var(--space-xl);
    }
  }
  .lead {
    max-width: var(--text-measure);
    font-size: var(--text-body);
    line-height: 1.45;
    color: var(--color-body);
  }
</style>
