---
/**
 * Numbered case section (Figma "Section/…", e.g. 251:1387).
 * Heading, then groups 48 px apart, 120 px space below.
 */
import CaseSectionHeading from '../CaseSectionHeading.astro';

interface Props {
  /** Anchor used by the table of contents */
  id: string;
  number: string;
  label?: string;
  title: string;
  /** Space between the heading and groups: default 48 px, loose 80 px (TV-aksjonen) */
  spacing?: 'default' | 'loose';
}
const { id, number, label, title, spacing = 'default' } = Astro.props;
---

<section
  class:list={['case-section', 'prose', { 'case-section--loose': spacing === 'loose' }]}
  id={id}
  aria-labelledby={`${id}-heading`}
>
  <CaseSectionHeading number={number} label={label} id={`${id}-heading`}>{title}</CaseSectionHeading>
  <slot />
</section>

<style>
  .case-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
    padding-bottom: var(--space-section);
    scroll-margin-top: var(--space-xl);
  }
  .case-section--loose {
    gap: 80px;
  }
  @media (max-width: 767px) {
    .case-section--loose {
      gap: var(--space-2xl);
    }
  }
</style>
