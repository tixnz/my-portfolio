---
/** A group of related content inside a section (Figma "gruppe/…"): 32 px gap. */
interface Props {
  /** default 32 px, loose 40 px (Figma "gruppe/iterasjoner"), tight 12 px */
  gap?: 'default' | 'loose' | 'tight';
}
const { gap = 'default' } = Astro.props;
---

<div class:list={['group', `group--${gap}`]}><slot /></div>

<style>
  .group {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }
  .group--loose {
    gap: 40px;
  }
  .group--tight {
    gap: var(--space-s);
  }
</style>
