---
/**
 * Labelled text beside a portrait image (Figma UNG + MUNCH "Innsikt", 192:1274).
 * Text fills the row, image 331.5 × 442 on the right, 96 px apart.
 */
import { Image } from 'astro:assets';
import { resolveImage, type ImageRef } from '../../lib/images';

interface Props {
  label: string;
  src: ImageRef;
  alt: string;
  imageWidth?: number;
  imageHeight?: number;
}
const { label, src, alt, imageWidth = 332, imageHeight = 442 } = Astro.props;
---

<section class="text-image prose">
  <div class="text">
    <h2 class="block-label">{label}</h2>
    <slot />
  </div>
  <Image
    src={resolveImage(src)}
    alt={alt}
    widths={[imageWidth, imageWidth * 2]}
    sizes={`(max-width: 767px) 100vw, ${imageWidth}px`}
    class="img"
    style={`--w: ${imageWidth}px; --ratio: ${imageWidth} / ${imageHeight}`}
  />
</section>

<style>
  .text-image {
    display: flex;
    align-items: flex-start;
    gap: 96px;
    padding-bottom: var(--space-3xl);
  }
  .text {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    gap: 20px;
    min-width: 0;
  }
  .text :global(p) {
    line-height: 1.5;
    color: var(--color-ink-strong);
  }
  .img {
    flex: 0 0 var(--w);
    width: var(--w);
    height: auto;
    aspect-ratio: var(--ratio);
    object-fit: cover;
  }
  @media (max-width: 767px) {
    .text-image {
      flex-direction: column;
      gap: var(--space-xl);
    }
    .img {
      flex-basis: auto;
      width: 100%;
    }
  }
</style>
