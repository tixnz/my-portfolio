---
/**
 * Concepts side by side (Figma "gruppe/test", 251:1453). Each has a pill tag
 * (outlined, or filled accent for the chosen one), an image and a caption.
 */
import { Image } from 'astro:assets';
import { resolveImage, type ImageRef } from '../../lib/images';

interface Props {
  items: { tag: string; chosen?: boolean; src: ImageRef; alt: string; caption?: string }[];
  /** Image height in px on desktop */
  height?: number;
}
const { items, height = 560 } = Astro.props;
---

<div class="concepts" style={`--h: ${height}px`}>
  {
    items.map((item) => (
      <figure class="concept">
        <span class:list={['tag', { 'tag--chosen': item.chosen }]}>{item.tag}</span>
        <Image
          src={resolveImage(item.src)}
          alt={item.alt}
          widths={[540, 1080]}
          sizes="(max-width: 767px) 100vw, 536px"
          class="img"
        />
        {item.caption && <figcaption>{item.caption}</figcaption>}
      </figure>
    ))
  }
</div>

<style>
  .concepts {
    display: flex;
    gap: var(--space-m);
  }
  .concept {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    min-width: 0;
    margin: 0;
  }
  .tag {
    padding: 6px 14px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: var(--text-label);
    font-weight: var(--weight-medium);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.45;
    white-space: pre;
    color: var(--color-ink-muted);
  }
  .tag--chosen {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-surface);
  }
  .img {
    width: 100%;
    height: var(--h);
    object-fit: contain;
  }
  figcaption {
    font-size: var(--text-caption);
    line-height: 1.4;
    color: var(--color-label);
  }

  @media (max-width: 767px) {
    .concepts {
      flex-direction: column;
      gap: var(--space-xl);
    }
    .img {
      height: auto;
      max-height: 480px;
    }
  }
</style>
