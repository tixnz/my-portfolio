---
/**
 * Image figure with an optional caption.
 *   single  – one image (Figma 251:1486, 640 high)
 *   pair    – two equal images, 16 px apart (Figma 265:1719, 402 high)
 *   feature – large image + a 372 px column of two stacked images (Figma 264:1746, 360 high)
 *
 * fit:   cover (crop to fill, default) or contain (show the whole image, e.g. diagrams)
 * width: limit the figure width (px); align it left or centre in the column
 * On phones the images stack and keep their own proportions.
 */
import { Image } from 'astro:assets';
import { resolveImage, type ImageRef } from '../../lib/images';

interface Props {
  images: { src: ImageRef; alt: string }[];
  layout?: 'single' | 'pair' | 'feature';
  /** Row height in px on desktop */
  height?: number;
  width?: number;
  align?: 'start' | 'center';
  fit?: 'cover' | 'contain';
  /** Gap between images in px (default 16) */
  gap?: number;
  caption?: string;
}

const {
  images,
  layout = 'single',
  height = 480,
  width,
  align = 'start',
  fit = 'cover',
  gap = 16,
  caption,
} = Astro.props;
const resolved = images.map((img) => ({ ...img, src: resolveImage(img.src) }));
const maxW = width ?? 1088;

/*
 * Generate each image at its desktop display width (1×, 2×) plus a phone size,
 * never wider than the original. Phones show every image at full width (~390).
 */
const featureMain = maxW - 372 - gap;
const displayWidth = layout === 'pair' ? Math.round((maxW - gap) / 2) : maxW;
const widthsFor = (w: number, original: number) =>
  [...new Set([390, 780, w, w * 2].map(Math.round))].filter((x) => x <= original).sort((a, b) => a - b);
const sizesFor = (w: number) => `(max-width: 767px) calc(100vw - 40px), ${w}px`;
const style = [`--h: ${height}px`, width ? `--w: ${width}px` : '', `--fit: ${fit}`, `--gap: ${gap}px`]
  .filter(Boolean)
  .join('; ');
---

<figure class:list={['figure', `figure--${layout}`, `figure--${align}`]} style={style}>
  <div class="images">
    {
      layout === 'feature' ? (
        <>
          <Image
            src={resolved[0].src}
            alt={resolved[0].alt}
            widths={widthsFor(featureMain, resolved[0].src.width)}
            width={Math.min(featureMain, resolved[0].src.width)}
            sizes={sizesFor(featureMain)}
            class="img main"
          />
          <div class="col">
            {resolved.slice(1).map((img) => (
              <Image
                src={img.src}
                alt={img.alt}
                widths={widthsFor(372, img.src.width)}
                width={Math.min(372, img.src.width)}
                sizes={sizesFor(372)}
                class="img"
              />
            ))}
          </div>
        </>
      ) : (
        resolved.map((img) => (
          <Image
            src={img.src}
            alt={img.alt}
            widths={widthsFor(displayWidth, img.src.width)}
            width={Math.min(displayWidth, img.src.width)}
            sizes={sizesFor(displayWidth)}
            class="img"
          />
        ))
      )
    }
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    width: 100%;
    max-width: var(--w, none);
    margin: 0;
  }
  .figure--center {
    align-self: center;
  }
  .images {
    display: flex;
    gap: var(--gap);
    height: var(--h);
  }
  .img {
    flex: 1 1 0;
    min-width: 0;
    height: 100%;
    object-fit: var(--fit);
    border-radius: var(--radius-xs);
  }
  .col {
    display: flex;
    flex: 0 0 372px;
    flex-direction: column;
    gap: var(--space-m);
  }
  .col .img {
    width: 100%;
    min-height: 0;
  }
  figcaption {
    font-size: var(--text-caption);
    line-height: normal;
    color: var(--color-label);
  }

  @media (max-width: 767px) {
    .images,
    .col {
      flex-direction: column;
      height: auto;
    }
    .col {
      flex-basis: auto;
    }
    .img {
      flex: none;
      width: 100%;
      height: auto;
    }
  }
</style>
