---
/** Short titled text block, e.g. a lesson learned (Figma "block/…", 251:1480). */
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<div class="text-block">
  <h3>{title}</h3>
  <slot />
</div>

<style>
  .text-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }
</style>
