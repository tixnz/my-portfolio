---
/**
 * Neste prosjekt (Figma 251:1488). 96 px title with an accent arrow; the whole
 * row is one link. Hover: title turns accent and the arrow slides right.
 */
import { t } from '../../i18n/ui.no';

interface Props {
  title: string;
  href: string;
}
const { title, href } = Astro.props;
---

<nav class="next" aria-label={t('case.nextProject')}>
  <div class="page inner">
    <p class="label">{t('case.nextProject')}</p>
    <a class="row" href={href}>
      <span class="name">{title}</span>
      <span class="arrow" aria-hidden="true">→</span>
    </a>
  </div>
</nav>

<style>
  .next {
    border-top: 1px solid var(--color-border);
  }
  .inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-section);
  }
  .label {
    font-size: var(--text-caption);
  }
  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
    font-size: clamp(2.5rem, 6.67vw, 6rem); /* 96 px at 1440 */
    line-height: 0.95;
  }
  .name {
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--color-ink-strong);
    transition: color var(--duration) var(--ease-out);
  }
  .arrow {
    color: var(--color-accent);
    transition: transform var(--duration) var(--ease-out);
  }
  .row:hover .name {
    color: var(--color-accent);
  }
  .row:hover .arrow {
    transform: translateX(8px);
  }
</style>
