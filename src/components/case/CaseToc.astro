---
/**
 * Sticky table of contents (Figma 251:1368). Numbered links to the sections;
 * the section in view gets an accent bar and number. Hidden below 1024 px.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { t } from '../../i18n/ui.no';

interface Props {
  items: { id: string; label: string }[];
  logo?: ImageMetadata;
  logoAlt?: string;
  logoHeight?: number;
}
const { items, logo, logoAlt = '', logoHeight = 52 } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<nav class="toc" aria-label={t('case.contents')} data-toc>
  {
    logo && (
      <Image
        src={logo}
        alt={logoAlt}
        class="logo"
        height={logoHeight}
        densities={[1, 2]}
        style={`height: ${logoHeight}px`}
      />
    )
  }
  <ol>
    {
      items.map((item, i) => (
        <li>
          <a href={`#${item.id}`} data-toc-link={item.id}>
            <span class="bar" aria-hidden="true" />
            <span class="num">{pad(i + 1)}</span>
            <span class="label">{item.label}</span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .toc {
    position: sticky;
    top: var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-top: 8px;
  }
  .logo {
    align-self: flex-start;
    width: auto;
  }
  ol {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 0;
    list-style: none;
  }
  a {
    display: flex;
    align-items: center;
    gap: 10px;
    line-height: normal;
    color: var(--color-label);
    transition: color var(--duration) var(--ease-out);
  }
  .bar {
    display: none;
    width: 2px;
    height: 18px;
    background: var(--color-accent);
  }
  .num {
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
  }
  .label {
    font-size: 17px;
  }
  a:hover {
    color: var(--color-ink);
  }
  a[aria-current='true'] .bar {
    display: block;
  }
  a[aria-current='true'] .num {
    color: var(--color-accent);
  }
</style>

<script>
  const toc = document.querySelector<HTMLElement>('[data-toc]');
  if (toc) {
    const links = new Map(
      [...toc.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')].map((a) => [
        a.dataset.tocLink!,
        a,
      ]),
    );
    const sections = [...links.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    const setActive = (id: string | null) => {
      links.forEach((a, key) => a.setAttribute('aria-current', String(key === id)));
    };

    // The active section is the last one whose top has passed 35 % of the viewport.
    const update = () => {
      const line = window.innerHeight * 0.35;
      let current: string | null = null;
      for (const section of sections) {
        if (section.getBoundingClientRect().top <= line) current = section.id;
      }
      setActive(current ?? sections[0]?.id ?? null);
    };

    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
  }
</script>
