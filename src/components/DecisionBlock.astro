---
/**
 * Decision block: label, title and text with an accent line on the left.
 * No standalone component exists in Figma for this yet; type sizes follow the
 * lærdom blocks (Figma 333:8031): 28 px medium title, 22 px body.
 */
interface Props {
  label?: string;
  title: string;
  as?: 'h3' | 'h4';
}
const { label, title, as: Heading = 'h3' } = Astro.props;
---

<div class="decision">
  {label && <p class="label-text">{label}</p>}
  <Heading class="title">{title}</Heading>
  <div class="text"><slot /></div>
</div>

<style>
  .decision {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    padding-left: var(--space-l);
    border-left: 2px solid var(--color-accent);
  }
  .label-text {
    font-size: var(--text-small);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    line-height: normal;
    color: var(--color-accent);
  }
  .title {
    font-size: var(--text-h3);
    font-weight: var(--weight-medium);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--color-ink-strong);
  }
  .text {
    font-size: var(--text-body);
    line-height: 1.55;
    color: var(--color-body);
  }
  .text :global(p + p) {
    margin-top: 1em;
  }
</style>
