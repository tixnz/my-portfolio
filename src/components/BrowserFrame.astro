---
/**
 * Browser mockup (Figma "nettleser/Admin (scroll)", 339:7594). Window bar with
 * three dots and an address field, built in code; only the screenshot is an
 * image. Measurements are from the 975 px wide frame and scale with the width.
 *
 * scrollable: the screenshot scrolls vertically inside the window
 * (TV-aksjonen result). Pass a full-page screenshot.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image?: ImageMetadata;
  alt?: string;
  /** Rendered width in px on desktop */
  width?: number;
  /** Visible screen aspect ratio (width / height) below the bar */
  screenRatio?: number;
  /** Text in the address field, e.g. "https://delfor.tvaksjonen.no/" */
  address?: string;
  scrollable?: boolean;
  scrollLabel?: string;
  shadow?: boolean;
}

const {
  image,
  alt = '',
  width = 975,
  screenRatio = 975 / 704,
  address,
  scrollable = false,
  scrollLabel,
  shadow = false,
} = Astro.props;
---

<div
  class:list={['browser', { 'browser--shadow': shadow }]}
  style={`--browser-w: ${width}px; --screen-ratio: ${screenRatio}`}
>
  <div class="bar" aria-hidden="true">
    <span class="dots"><span></span><span></span><span></span></span>
    <span class="address">{address}</span>
  </div>
  <div
    class:list={['screen', { 'screen--scroll': scrollable }]}
    tabindex={scrollable ? 0 : undefined}
    role={scrollable ? 'region' : undefined}
    aria-label={scrollable ? (scrollLabel ?? alt) : undefined}
  >
    {
      image && (
        <Image
          src={image}
          alt={alt}
          widths={[width, width * 2].filter((w) => w <= image.width)}
          sizes={`(max-width: 767px) 100vw, ${width}px`}
          class="shot"
        />
      )
    }
  </div>
</div>

<style>
  .browser {
    container-type: inline-size;
    width: min(var(--browser-w), 100%);
    overflow: hidden;
    border: 1px solid #d6d6d4;
    border-radius: max(4px, calc(12 * 100cqw / 975));
    background: #fff;
  }
  .browser--shadow {
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.12);
  }
  /* 1 Figma px = 100cqw / 975 */
  .bar {
    position: relative;
    display: flex;
    align-items: center;
    height: calc(36 * 100cqw / 975);
    padding-left: calc(14 * 100cqw / 975);
    background: var(--browser-bar);
  }
  .dots {
    display: flex;
    gap: calc(6 * 100cqw / 975);
  }
  .dots span {
    width: calc(10 * 100cqw / 975);
    aspect-ratio: 1;
    border-radius: 50%;
    background: #ff5f57;
  }
  .dots span:nth-child(2) {
    background: #febc2e;
  }
  .dots span:nth-child(3) {
    background: #28c840;
  }
  .address {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    place-items: center;
    width: calc(380 * 100cqw / 975);
    height: calc(22 * 100cqw / 975);
    transform: translate(-50%, -50%);
    border: 1px solid #dadada;
    border-radius: calc(6 * 100cqw / 975);
    background: var(--browser-field);
    font-size: calc(12 * 100cqw / 975);
    line-height: 1;
    text-decoration: underline;
    white-space: nowrap;
    color: #000;
  }

  .screen {
    aspect-ratio: var(--screen-ratio);
    overflow: hidden;
    background: #fff;
  }
  .screen :global(.shot) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .screen--scroll {
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .screen--scroll :global(.shot) {
    height: auto;
  }
  .screen--scroll:focus-visible {
    outline-offset: -2px;
  }
</style>
