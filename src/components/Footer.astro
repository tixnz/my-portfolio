---
/**
 * Footer (enkel) (Figma 207:1254). Copyright only. The Lys and Mørk variants
 * come from the page theme tokens.
 */
import { t } from '../i18n/ui.no';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="inner">
    <p>{t('footer.copyright', { year })}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
  }
  .inner {
    max-width: var(--page-max);
    margin-inline: auto;
    padding: var(--space-xl) var(--page-margin);
  }
  p {
    font-size: var(--text-small);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    line-height: normal;
    color: var(--color-ink-muted);
  }
  /* Mobile (Figma 398:11776): 12 px, 24 / 32 px padding */
  @media (max-width: 767px) {
    .inner {
      padding: 24px var(--page-margin) 32px;
    }
    p {
      font-size: 12px;
    }
  }
</style>
