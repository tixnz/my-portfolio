---
/**
 * Logo/ZT (Figma 394:8496). Two overlapping letters, 30 × 48 at 32 px.
 * Swap for the exported SVG when it is in /public (phase 8) if preferred.
 */
import { site } from '../content/site';
import { t } from '../i18n/ui.no';

interface Props {
  href?: string;
}
const { href = '/' } = Astro.props;
---

<a class="logo" href={href} aria-label={`${site.name}, ${t('nav.home').toLowerCase()}`}>
  <span class="z" aria-hidden="true">Z</span>
  <span class="t" aria-hidden="true">T</span>
</a>

<style>
  .logo {
    position: relative;
    display: block;
    flex-shrink: 0;
    width: 30px;
    height: 48px;
    font-size: 32px;
    line-height: 1.5;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    transition: color var(--duration) var(--ease-out);
  }
  .logo:hover {
    color: var(--color-accent);
  }
  /* Mobile header (Figma 398:11739): 24 px, 22.5 × 36 */
  @media (max-width: 767px) {
    .logo {
      width: 22.5px;
      height: 36px;
      font-size: 24px;
    }
  }
  .z,
  .t {
    position: absolute;
    top: 0;
  }
  .z {
    left: 0;
  }
  .t {
    left: 30%;
  }
</style>
