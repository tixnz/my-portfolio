---
/**
 * Project card (asymmetric) (Figma 117:69, used as 117:697 / 117:684).
 * Two shapes are mixed on the front page:
 *   wide: 690 px column, 690 × 400 media
 *   tall: 620 px column, 620 × 600 media
 * Hover and keyboard focus: the image zooms to 112 % from the centre inside the
 * cropped frame, the title turns accent (no underline) and "Se prosjekt ↗"
 * appears. About 600 ms ease-in-out. The whole card is one link.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { t } from '../i18n/ui.no';

interface Props {
  href: string;
  title: string;
  meta: string;
  summary: string;
  image?: ImageMetadata;
  imageAlt?: string;
  size?: 'wide' | 'tall';
  headingLevel?: 'h2' | 'h3';
}

const {
  href,
  title,
  meta,
  summary,
  image,
  imageAlt = '',
  size = 'wide',
  headingLevel: Heading = 'h3',
} = Astro.props;

const widths = size === 'wide' ? [460, 690, 1380] : [420, 620, 1240];
---

<a class:list={['card', `card--${size}`]} href={href}>
  <div class="media">
    {
      image && (
        <Image
          src={image}
          alt={imageAlt}
          widths={widths}
          sizes={`(max-width: 767px) 100vw, ${size === 'wide' ? 690 : 620}px`}
          class="img"
        />
      )
    }
  </div>
  <div class="info">
    <p class="meta">{meta}</p>
    <div class="title-row">
      <Heading class="title">{title}</Heading>
      <span class="cta" aria-hidden="true">{t('card.cta')}</span>
    </div>
    <p class="summary">{summary}</p>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: 100%;
    color: inherit;
  }
  .card--wide {
    max-width: 690px;
  }
  .card--tall {
    max-width: 620px;
  }

  .media {
    position: relative;
    overflow: hidden;
    background: var(--color-media);
  }
  .card--wide .media {
    aspect-ratio: 690 / 400;
  }
  .card--tall .media {
    aspect-ratio: 620 / 600;
  }
  .media :global(.img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform-origin: center;
    transition: transform var(--duration-slow) var(--ease-in-out);
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }
  .meta {
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    line-height: normal;
    color: var(--color-label);
  }
  .title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-m);
  }
  .title {
    font-size: var(--text-card-title);
    font-weight: var(--weight-medium);
    letter-spacing: -0.015em;
    line-height: normal;
    color: var(--color-ink-strong);
    transition: color var(--duration-slow) var(--ease-in-out);
  }
  .cta {
    flex-shrink: 0;
    font-size: var(--text-nav);
    letter-spacing: var(--tracking-nav);
    color: var(--color-accent);
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity var(--duration-slow) var(--ease-in-out),
      transform var(--duration-slow) var(--ease-in-out);
  }
  .summary {
    max-width: 560px;
    font-size: var(--text-nav);
    line-height: 1.5;
    color: var(--color-label);
  }

  .card:hover .media :global(.img),
  .card:focus-visible .media :global(.img) {
    transform: scale(1.12);
  }
  .card:hover .title,
  .card:focus-visible .title {
    color: var(--color-accent);
  }
  .card:hover .cta,
  .card:focus-visible .cta {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .card:hover .media :global(.img),
    .card:focus-visible .media :global(.img) {
      transform: none;
    }
  }
</style>
